{
  "name" : "pvsaintpe/ltree-bundle",
  "description" : "Symfony 6 bundle for postgresql ltee extension",
  "type" : "symfony-bundle",
  "homepage": "https://github.com/pvsaintpe/ltree-bundle",
  "license" : "MIT",
  "keywords" : ["ltree", "postgresql", "symfony", "symfony6", "symfony7", "php8", "php", "nested"],
  "authors" : [
      {
        "name" : "Veselov Pavel",
        "email" : "pvsaintpe@icloud.com"
      }
  ],
  "require" : {
    "php": ">=8.1",
    "symfony/property-access": "^6.4",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/orm": "^2.20 || ^3.0"
  },
  "autoload" : {
    "psr-4" : {
      "Pvsaintpe\\LTreeBundle\\" : "src/"
    }
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "id": "",
      "allow-contrib": false,
      "require": "6.4.*"
    }
  }
}
